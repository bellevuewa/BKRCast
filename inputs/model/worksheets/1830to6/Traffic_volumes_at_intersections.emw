[Parameter conversion]
# String Name: layer name that appears on layer control tab (tr,subst)
Name = Turn Value
# Text Description: user definable layer description (tr,subst)
Description = Resulting turn value (Sync: TurnValue2) to show or not turns using connectors
# Flags Flags: bit pattern containing layer flags
Flags = 0xbfb0000
# Bool CFlag: display layer controls
CFlag = 0
# Bool SFlag: display layer on screen
SFlag : SFlag/
SFlag = 0
# Bool MFlag: display layer under the magnifier
MFlag : /SFlag
MFlag = 0
# Integer IA: integer parameter IA
IA : ConnectorTurns
IA = 0
# String SA: string parameter SA (subst,nosave)
SA : (0x80) /TurnValue
# Box BA: box parameter BA
BA = 0;0;0;0
# Box BB: box parameter BB
BB = 0;0;0;0
# Box BC: box parameter BC
BC = 0;0;0;0
# Box BD: box parameter BD
BD = 0;0;0;0
# Box BE: box parameter BE
BE = 0;0;0;0
# Expression Expression: expression for parameter conversion (tr,string,max. 12 values)
Expression = if(IA,SA,"("+SA+")* not((Pi->isZone)||(Pk->isZone))")
# String SR: string result (nosave)
SR : (0x80) TurnValue2
# Box BR: box result
BR = 0;0;0;0

[Parameter conversion]
# String Name: layer name that appears on layer control tab (tr,subst)
Name = Transformation matrix
# Text Description: user definable layer description (tr,subst)
Description : (0x800)
Description = Computes transformation matrix following rotation angle
# Flags Flags: bit pattern containing layer flags
Flags = 0xbfb0000
# Bool CFlag: display layer controls
CFlag = 0
# Bool SFlag: display layer on screen
SFlag : SFlag/
SFlag = 0
# Bool MFlag: display layer under the magnifier
MFlag : /SFlag
MFlag = 0
# Float FA: floating point parameter FA (nosave)
FA : (0x80) /IntersectionPosition
# Integer IA: integer parameter IA
IA : RotationAngle
IA = 0
# Expression Expression: expression for parameter conversion (tr,string,max. 12 values)
Expression = FA,FA1,Cos(IA),Cos(IA),FA,FA1,Sin(IA),-Sin(IA)
# Float FR: floating point result (nosave)
FR : (0x80) TransformationMatrix/
# Integer IR: integer result (nosave)
IR : (0x80)
# String SR: string result (nosave)
SR : (0x80)
# Box BR: box result
BR = 0;0;1;1

[Parameter conversion]
# String Name: layer name that appears on layer control tab (tr,subst)
Name = Turn selector
# Text Description: user definable layer description (tr,subst)
Description : (0x800)
Description = Generates turn selector \
(turns with positive volume from or to the selected intersection node).\
Receives '>SelectedIntersection' from node parameter layer and selects turns \
total volume is positive.
# Flags Flags: bit pattern containing layer flags
Flags = 0xbfb0000
# Bool CFlag: display layer controls
CFlag = 0
# Bool SFlag: display layer on screen
SFlag : SFlag/
SFlag = 0
# Bool MFlag: display layer under the magnifier
MFlag : /SFlag
MFlag = 0
# String SA: string parameter SA (subst,nosave)
SA : (0xb0) />SelectedIntersection
# Expression Expression: expression for parameter conversion (tr,string,max. 12 values)
Expression = "Pj->("+uncomment(SA)+")&&(pvolau+pvolad>0)"
# String SR: string result
SR : TurnSelector
SR = Pj->( isMarked)&&(pvolau+pvolad>0)

[Turn parameter]
# String Name: layer name that appears on layer control tab (tr,subst)
Name = Turn table
# Text Description: user definable layer description (tr,subst)
Description : (0x800)
Description = Generates an expression to diplay the 'from' node, 'to' node \
traffic volume and additional volume for each turn.
# Flags Flags: bit pattern containing layer flags
Flags = 0xbfb0000
# Bool CFlag: display layer controls
CFlag = 0
# Bool SFlag: display layer on screen
SFlag : SFlag/
SFlag = 0
# Bool MFlag: display layer under the magnifier
MFlag : /SFlag
MFlag = 0
# Bool AFlag: set active flag of filtered elements
AFlag = 0
# Bool ResetToDefault: reset to default values before each evaluation
ResetToDefault = 1
# Integer StartingIndex: starting index for computed parameter values
StartingIndex = 1
# Expression Value: expression for parameter values (tr,turn,string)
Value : //>SelectedIntersection
Value = string(i,0,6) + string(k,0,7) +": "+string(pvolau,0,6)+string(pvolad,0,6)
# Filter Filter: expression for element filtering [, iterator] (tr,turn,string,max. 2 values)
Filter : /TurnSelector
Filter = Pj->( isMarked)&&(pvolau+pvolad>0)
# String DefaultValues: default values for indices below starting index (subst)
DefaultValues : (0x800)
DefaultValues = from:     to:  volau volad
# String ResultValues: parameter in which results are stored (nosave)
ResultValues : TurnTable/

[Node parameter]
# String Name: layer name that appears on layer control tab (tr,subst)
Name = Intersection nodes
# Text Description: user definable layer description (tr,subst)
Description : (0x800)
Description = Generates predefined choices corresponding to individual intersection nodes.
# Flags Flags: bit pattern containing layer flags
Flags = 0xbfb0000
# Bool CFlag: display layer controls
CFlag = 0
# Bool SFlag: display layer on screen
SFlag : SFlag/
SFlag = 0
# Bool MFlag: display layer under the magnifier
MFlag : /SFlag
MFlag = 0
# Bool AFlag: set active flag of filtered elements
AFlag = 0
# Bool ResetToDefault: reset to default values before each evaluation
ResetToDefault = 1
# Integer StartingIndex: starting index for computed parameter values
StartingIndex = 2
# Expression Value: expression for parameter values (tr,node,string)
Value = "i=="+id
# Filter Filter: expression for element filtering [, iterator] (tr,node,string,max. 2 values)
Filter = [intersection nodes] isIntersection
# String DefaultValues: default values for indices below starting index (subst)
DefaultValues[] = [intersection selected in the table] isMarked
DefaultValues[] = [intersection selected in the table] isMarked
# String ResultValues: parameter in which results are stored (nosave)
ResultValues : >SelectedIntersection/

[Node parameter]
# String Name: layer name that appears on layer control tab (tr,subst)
Name = Selected node
# Text Description: user definable layer description (tr,subst)
Description : (0x800)
Description = Identifier of the selected node
# Flags Flags: bit pattern containing layer flags
Flags = 0xbfb0000
# Bool CFlag: display layer controls
CFlag = 0
# Bool SFlag: display layer on screen
SFlag : SFlag/
SFlag = 0
# Bool MFlag: display layer under the magnifier
MFlag : /SFlag
MFlag = 0
# Bool AFlag: set active flag of filtered elements
AFlag = 0
# Integer MaximumNumberOfValues: maximum number of values to be evaluated
MaximumNumberOfValues = 1
# Expression Value: expression for parameter values (tr,node,string)
Value = id
# Filter Filter: expression for element filtering [, iterator] (tr,nosave,node,string,max. 2 values)
Filter : (0x80) />SelectedIntersection/$NumberOfMarkedNodes*
# String ResultValues: parameter in which results are stored (nosave)
ResultValues : @SelectedNode

