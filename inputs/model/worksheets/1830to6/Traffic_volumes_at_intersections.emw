Filter : JNodeSelector
Filter[] = [all nodes] isIActive&&isAuto
Filter[] = [all nodes] isIActive&&isAuto
Filter[] = [regular nodes] isIActive&&isAuto&&not(isConnector)
Filter[] = [centroids] isIActive&&isAuto&&isConnector
# Expression StyleIndex: expression for style index (tr,link,string)
StyleIndex : RdStyleIndex
StyleIndex = 

