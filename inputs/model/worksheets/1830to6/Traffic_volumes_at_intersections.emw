[Configurable control]
# String Name: layer name that appears on layer control tab (tr,subst)
Name = Nodes
# Text Description: user definable layer description (tr,subst)
Description : (0x800)
Description = Gives access to the parameters defining the display of the node circles\
(_ALL_INTER_NODES)
# Flags Flags: bit pattern containing layer flags
Flags = 0xbda0000
# String TranslationContext: context for translations of configuration texts (subst)
TranslationContext[] = Symb
TranslationContext[] = SelectorField
TranslationContext[] = Mapper
# Bool CFlag: display layer controls
CFlag = 1
# Bool SFlag: display layer on screen
SFlag : ShowNodes
SFlag = 1
# Bool MFlag: display layer under the magnifier
MFlag : /ShowNodes
MFlag = 0
# Bool IFlag: allow interactive input
IFlag = 0
# Bool TFlag: provide tips
TFlag = 0
# Bool BFlag: include bounding box in full view
BFlag : /ShowNodes
BFlag = 0
# String Layout: layout parameters (tr)
Layout[] = Filter0;Filter;Node filter:;nodes connected to the incoming and outgoing links;0;0;0;0;links;
Layout[] = String0;String combo;Symbol:;shape used for drawing nodes;1;1;0;0;;
Layout[] = Bool0;Checkbox;Adjacent nodes;display adjacent nodes;2;2;0;0;;
Layout[] = Bool1;Checkbox;Intersection ID;display intersection ID;3;3;0;0;;
Layout[] = Float0;Scale;Node diameter:;node diameter (in pixels);4;4;0;0;0
Layout[] = Float2;Scale;Distance factor:;distance factor from intersection circle;5;5;0;0;0
Layout[] = Float1;Spinbox;Text size:;text size for node numbers;6;6;0;0;0;100;
Layout[] = Integer0;Spinbox;Rotation angle:;rotation angle in degrees;7;7;0;0;-9999;9999;
Layout[] = Style0;Style;Node style:;Node symbol style (regular nodes, centroids, intersections);8;8;0;0;;
# Bool Bool0: display adjacent nodes
Bool0 : DisplayNodes
Bool0 = 1
# Bool Bool1: display intersection ID
Bool1 : ShowIntersectionID
Bool1 = 0
# Integer Integer0: rotation angle in degrees
Integer0 : RotationAngle
Integer0 = 0
# Float Float0: node diameter (in pixels)
Float0 : NodeDiameter/
Float0 = 50
# Float Float1: text size for node numbers
Float1 : NodeTextSize
Float1 = 14
# Float Float2: distance factor from intersection circle
Float2 : DistanceFactor/
Float2 = 1.2
# String String0: shape used for drawing nodes
String0 : (0x820) SymbolIndex/
String0[] = Circle
String0[] = No shape
String0[] = Circle
String0[] = Square
String0[] = Diamond
String0[] = Delta
String0[] = Nabla
String0[] = Star
# Filter Filter0: nodes connected to the incoming and outgoing links (tr,link,string,max. 2 values)
Filter0 : (0x70) JNodeSelector
Filter0[] = [all nodes] isIActive&&isAuto
Filter0[] = [all nodes] isIActive&&isAuto
Filter0[] = [regular nodes] isIActive&&isAuto&&not(isConnector)
Filter0[] = [centroids] isIActive&&isAuto&&isConnector
# Style Style0: Node symbol style (regular nodes, centroids, intersections)
Style0 : (0x200) Nodes!/Nodes!/$WorksheetLoaded
Style0[] = 0x2088896d 0x01fffddb 0x00000000 0x00000000
Style0[] = 0x20ff5c0a 0x01ffe4d7 0x00000000 0x00000000
Style0[] = 0x2000665f 0x01bef9be 0x00000000 0x00000000
Style0[] = 0x2000647f 0x01afdbdc 0x00000000 0x00000000
Style0[] = 0x207e5f08 0x01b5a57c 0x00000000 0x00000000

[Parameter conversion]
# String Name: layer name that appears on layer control tab (tr,subst)
Name = English symbol
# Text Description: user definable layer description (tr,subst)
Description = Send English name of chosen symbol (_ALL_SYMBOLS)
# Flags Flags: bit pattern containing layer flags
Flags = 0xbfb0000
# String TranslationContext: context for translations of configuration texts (subst)
TranslationContext[] = SymbolMapper
TranslationContext[] = Mapper
# Bool CFlag: display layer controls
CFlag = 0
# Bool SFlag: display layer on screen
SFlag : SFlag/
SFlag = 0
# Bool MFlag: display layer under the magnifier
MFlag : /SFlag
MFlag = 0
# Integer IA: integer parameter IA
IA : (0x100) //SymbolIndex
IA = 2
# Integer IB: integer parameter IB
IB : /DisplayNodes
IB = 1
# Expression Expression: expression for parameter conversion (tr,string,max. 12 values)
Expression = if(IB,lookup(IA,"No shape","Circle","Square","Diamond","Delta","Nabla","Star"),"No shape")
# String SR: string result (nosave)
SR : (0x80) Symbol/

[Parameter conversion]
# String Name: layer name that appears on layer control tab (tr,subst)
Name = Outgoing link position
# Text Description: user definable layer description (tr,subst)
Description = Used by Link info Configurable control (_ALL_INTER_LINKS)
# Flags Flags: bit pattern containing layer flags
Flags = 0xbfb0000
# Bool CFlag: display layer controls
CFlag = 0
# Bool SFlag: display layer on screen
SFlag : SFlag/
SFlag = 0
# Bool MFlag: display layer under the magnifier
MFlag : /SFlag
MFlag = 0
# Float FA: floating point parameter FA
FA : /Diameter
FA = 392.250079822891
# String SA: string parameter SA (subst)
SA : //%CurrentView
SA = %<%ViewScale>%
# Float FB: floating point parameter FB (nosave)
FB : (0x80) /TextPosition
# Expression Expression: expression for parameter conversion (tr,string,max. 12 values)
Expression = put(FA/2*FB*number(SA))+"*Cos(angle),"+get(1)+"*Sin(angle),angle"
# String SR: string result (nosave)
SR : (0x80) JTextPosition/

[Parameter conversion]
# String Name: layer name that appears on layer control tab (tr,subst)
Name = One-way incoming link position
# Text Description: user definable layer description (tr,subst)
Description = Used by Link info Configurable control (_ALL_INTER_LINKS)
# Flags Flags: bit pattern containing layer flags
Flags = 0xbfb0000
# Bool CFlag: display layer controls
CFlag = 0
# Bool SFlag: display layer on screen
SFlag : SFlag/
SFlag = 0
# Bool MFlag: display layer under the magnifier
MFlag : /SFlag
MFlag = 0
# Float FA: floating point parameter FA
FA : /Diameter
FA = 392.250079822891
# String SA: string parameter SA (subst)
SA : //%CurrentView
SA = %<%ViewScale>%
# Float FB: floating point parameter FB (nosave)
FB : (0x80) /TextPosition
# Expression Expression: expression for parameter conversion (tr,string,max. 12 values)
Expression = put(FA/2*FB*number(SA))+"*(-Cos(angle)),"+get(1)+"*(-Sin(angle)),angle"
# String SR: string result (nosave)
SR : (0x80) ITextPosition/

[Link symbol]
# String Name: layer name that appears on layer control tab (tr,subst)
Name = Text on outgoing link of turn
